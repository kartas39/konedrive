[Unit]
Description=KOneDrive daemon

[Service]
Type=dbus
BusName=org.konedrive.Daemon
ExecStart=%h/.local/bin/konedrived
Restart=on-failure
# The daemon leaves with a failure when a task it cannot work without is gone.
# Each start brings every folder up again, so a
# failure that comes back at every start is tried every few seconds, not in a
# tight loop.
RestartSec=5
# Startup recovery (docs/design/hydration.md §9) walks every registered root holding one file
# descriptor at a time plus one per directory level, so the daemon's real need
# is the tree's depth plus the 64 opens it may take from the helper at once, the helper socket
# and D-Bus -- but running out is the failure that cost us 991 files left
# `hydrating` with untrusted content and no error, so this is deliberately an
# order of magnitude clear of anything the daemon can plausibly need rather
# than inheriting systemd's default of 1024.
LimitNOFILE=16384

[Install]
WantedBy=default.target
