[Unit]
Description=KOneDrive daemon

[Service]
Type=dbus
BusName=org.konedrive.Daemon
ExecStart=%h/.local/bin/konedrived
Restart=on-failure
# The daemon leaves with a failure when a task it cannot work without is gone.
# Each start brings every folder up again, so a
# failure that comes back at every start is tried every few seconds, not in a
# tight loop.
RestartSec=5
# After the daemon's end, however it ended: a folder loses the mount the daemon left on it and
# is locked, so that it shows its downloaded files and takes nothing until the daemon is back.
# The same program as ExecStart: the packages rewrite both lines (packaging/rpm/konedrive.spec).
ExecStopPost=%h/.local/bin/konedrived --tidy
# Deliberately an order of magnitude clear of anything the daemon can plausibly need, rather
# than systemd's default of 1024.
LimitNOFILE=16384

[Install]
WantedBy=default.target
