<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/konedrive/Accounts/<id>: this account's folder. Calls on one
       file or on chosen paths (Hydrate, Dehydrate, ItemState, Pin, Unpin,
       FreeUp) are org.konedrive.Files's, routed by path. The same object
       serves what moves
       (org.konedrive.Transfers), what waits to go up
       (org.konedrive.UploadQueue), the conflicts (org.konedrive.Conflicts),
       the check of the folder on disk at its start
       (org.konedrive.LocalScan) and the events
       (org.konedrive.ActivityLog). -->
  <interface name="org.konedrive.Folder">
    <!-- Registers the directory at the path as the account's folder: it
         shows the account's OneDrive through a mount of the daemon's own
         from then on. Refused Overlaps when the folder is, is inside, or
         contains another account's folder (the message names that
         account), NotEmpty when it is not empty or carries
         user.konedrive.drive naming another drive than this account's,
         and Unsupported for what is no directory or is on a filesystem
         that cannot hold a folder (the message says which). Refused
         AlreadyRegistered while the account has a folder, up or not: one
         config.toml records counts from the daemon's start. A registration
         that fails is undone in config.toml. -->
    <method name="Register">
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- Forgets the folder, up or not: the mount is taken off it, and the
         files downloaded so far and the files made here are left in it as
         plain local files.
         Never refused because changes made here are not uploaded: whoever
         asks accepts that those files stay only on this computer, as plain
         local files. A client warns before it calls, with the count of
         what is unsent. -->
    <method name="Unregister"/>
    <!-- Asks OneDrive for changes now rather than within the minute, and
         tries the changes waiting to be uploaded that are in backoff now.
         Reads the quota again (Account.QuotaRemaining, QuotaState, ...): with
         space again, a full OneDrive ends (UploadQueue.QuotaFull), and the
         files too big before go up once they fit.
         A folder that is down after a failure (a bring-up that failed, the
         folder moved away) is brought up first, and one whose sync could
         not start, or was taken down by a fault, has it started. Only the
         folder that was registered is brought up: a directory at its path
         that does not carry its root id is left alone. Refused NotUp, with
         why, when the bring-up fails, for a folder that only waits (State
         waiting), and for one whose sync cannot start.
         While paused, OneDrive is not asked. -->
    <method name="Refresh"/>
    <!-- Everything OneDrive has that the folder cannot hold, as (full path
         in OneDrive, reason, what keeps it here, where it is here): name-too-long,
         personal-vault, shared, onenote, reserved-name, unsupported. What
         is inside a skipped folder is covered by the folder's own entry.
         The third and the fourth field are empty for an item that is not on
         this computer. The fourth is the full path it has here while it still
         is: its old place, or a copy name beside it (name-<machine>) that it
         stepped aside to when another item took its name.
         An item that still is, because something of it waits, has what it
         waits for there, as <key>:<detail>: cycle (no plan has looked at
         it yet), uploads:<how many changes of it wait to be sent>, and
         open-for-writing with its full path (a program holds it open). It
         leaves the folder once none of these holds. An item still here
         that OneDrive has inside a folder that is not shown is an entry of
         its own, with that folder's reason. -->
    <method name="Skipped">
      <arg name="items" type="a(ssss)" direction="out"/>
      <!-- For Qt's generator (app/skippeditem.h); ignored by everything else. -->
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="KonedriveNotInFolderList"/>
    </method>
    <!-- Frees the space of every downloaded file under the folder: how many
         files, how many bytes. A file a pin keeps, a download is filling, a
         program holds open for writing or with a change waiting to be
         uploaded is left, and not counted. -->
    <method name="FreeUpSpace">
      <arg name="files" type="u" direction="out"/>
      <arg name="bytes" type="t" direction="out"/>
    </method>
    <!-- Pauses the account: nothing is uploaded, OneDrive is not asked for
         changes (so nothing is replaced), and no thumbnail is fetched, for
         `seconds` — or until Resume when 0. Opening a file still downloads
         it, Hydrate still works, and changes made here are still found and
         wait. The pause outlasts a restart of the daemon, and is taken
         whether the folder's sync runs or not: one that starts later starts
         paused. Refused Unsupported for a folder that is not connected to
         OneDrive, and NoRoot with no folder; Resume refuses the same. -->
    <method name="Pause">
      <arg name="seconds" type="u" direction="in"/>
    </method>
    <method name="Resume"/>
    <!-- The names of local files that are never uploaded, as shell globs
         matched against a name (not a path), case-sensitively; they apply
         only to files that did not come from OneDrive. Written to
         config.toml and taken at once: a name no longer ignored is
         uploaded, and a directory newly ignored takes the changes waiting
         inside it along. Refused
         org.freedesktop.DBus.Error.InvalidArgs for an empty pattern, one
         holding "/" or a NUL, and one longer than 255 bytes. -->
    <method name="SetIgnorePatterns">
      <arg name="patterns" type="as" direction="in"/>
    </method>
    <!-- The account's own sync setting (issue #80): written to the
         account's section of config.toml and taken at once, and refused
         Unsupported for a folder not connected to OneDrive, as Pause is.
         Whether Graph's thumbnails of images and videos
         are fetched (off, Dolphin downloads a cloud-only file in full to
         show its preview while its previews are on); turned on again, the
         items without one are asked for. -->
    <method name="SetThumbnails">
      <arg name="on" type="b" direction="in"/>
    </method>
    <!-- An account's own sync setting, as SetThumbnails is. How many gigabytes
         of the free space of the disk the folder is on the downloads of pinned
         files leave: a pinned file whose download would leave less is not
         downloaded, and LastError and Trouble say how many wait. 0 keeps
         nothing free. A read of a file and Files.Hydrate are not held. -->
    <method name="SetFreeSpaceReserve">
      <arg name="gigabytes" type="t" direction="in"/>
    </method>
    <!-- Lifts the automatic hold (HeldBack) now, until the network's Metered,
         UPower's OnBattery or the power profile changes, or
         Accounts.PauseOnMetered / OnBattery does. Only this account's hold is
         lifted. Not kept across a restart. Refused Unsupported for a folder
         not connected to OneDrive. -->
    <method name="SyncAnyway"/>
    <!-- The account's folder, up or not; empty when it has none. A folder
         config.toml records has its path from the daemon's start, while
         State is still waiting: it is not brought up yet. -->
    <property name="Path" type="s" access="read"/>
    <!-- none | waiting | ready | error.
         waiting: a folder is recorded and not up yet, and nothing is known
         to be wrong: it is being brought up. It reads error instead once
         the bring-up failed. LastError is empty while waiting. -->
    <property name="State" type="s" access="read"/>
    <!-- Every current problem, joined with ". ". While a changed file cannot
         be replaced here, one part reads "N file(s) changed in OneDrive could
         not be updated here yet: <reason>" (NotUpdated is that part alone).
         For the log and for older clients:
         nothing is decided by this text, Overall says the state. -->
    <property name="LastError" type="s" access="read"/>
    <!-- The state the account is in as a whole, and the reason for it. The
         daemon decides both; a client turns the reason into words and an
         icon. Announced whenever either changes, and never otherwise. The
         first rule that holds, in this order:
           offline  signing-in          the account is signing in
           offline  signed-out          the account is not signed in
           offline  no-folder           no folder is registered
           syncing  starting            the folder is recorded and not up yet
                                        (State is "waiting")
           warning  stopped             the folder's syncing has stopped on an
                                        error (State is "error")
           warning  conflicts           changed files were moved out of the way
           warning  quota-full          OneDrive is full, files wait for space
           warning  too-big             files are too big for the space left
           warning  blocked             changes cannot be uploaded
           warning  not-updated         files changed in OneDrive could not be
                                        updated here yet
           paused   paused              the user paused the account
           paused   held-back           the account holds back by itself
           paused   throttled           OneDrive asked the account to wait (429
                                        or 503 with a Retry-After): nothing is
                                        asked of it until then;
                                        Transfers.RetryAfter says the seconds
                                        left
           offline  unreachable         OneDrive cannot be reached, and nothing
                                        else is wrong
           warning  trouble             any other trouble that does not stop
                                        the folder
           syncing  listing             the first listing of the drive runs
           syncing  transferring        files are downloading or uploading, or
                                        changes wait to upload
           ok       up-to-date          none of the above
         A client that cannot reach the daemon at all shows "offline" by
         itself. -->
    <property name="Overall" type="(ss)" access="read">
      <!-- For Qt's generator (app/synctypes.h); ignored by everything else. -->
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="KonedriveOverall"/>
    </property>
    <!-- The sentence of the trouble there is now, whatever Overall's reason
         is; empty with none. While State is "error": everything LastError
         says. While State is "ready": the problems of
         LastError that do not stop the folder, OneDrive out of reach among
         them, joined with ". ", without the failed-update note. Empty in every other State: no such trouble is
         counted while the first listing runs. A client shows it as the
         sentence of "stopped", "trouble" and "unreachable", and may show it
         under any other reason too (a pause). -->
    <property name="Trouble" type="s" access="read"/>
    <!-- The failed-update note alone, "N file(s) changed in OneDrive could
         not be updated here yet: <reason>", whenever there is one, whatever
         Overall's reason is; empty otherwise. The sentence of
         "not-updated". -->
    <property name="NotUpdated" type="s" access="read"/>
    <!-- "onedrive": the folder shows this account's drive (Account.Mode
         says whether changes made here go up). Empty: the account has no
         folder. -->
    <property name="Source" type="s" access="read"/>
    <!-- Items in OneDrive (the root not counted), items in the folder, and
         skipped items: see Skipped(). Coalesced to a few changes a second. -->
    <property name="ItemsListed" type="t" access="read"/>
    <property name="ItemsPlaced" type="t" access="read"/>
    <property name="SkippedCount" type="t" access="read"/>
    <!-- Unix seconds of the last successful check with OneDrive; 0 = never. -->
    <property name="LastChecked" type="x" access="read"/>
    <!-- Bytes the folder's files take on this disk (st_blocks * 512, of
         the directory under the mount): a file that is not downloaded
         takes none. -->
    <property name="LocalBytes" type="t" access="read"/>
    <!-- How many files and folders carry their own "Always keep on this
         device" pin. -->
    <property name="PinnedCount" type="u" access="read"/>
    <!-- See SetIgnorePatterns; the defaults until it is called. -->
    <property name="IgnorePatterns" type="as" access="read"/>
    <property name="Paused" type="b" access="read"/>
    <!-- Unix seconds when the pause ends by itself; 0 while paused until
         Resume, and while not paused. -->
    <property name="PausedUntil" type="x" access="read"/>
    <!-- Why the account holds its background work back by itself: "metered"
         (a metered connection and Accounts.PauseOnMetered), "on-battery" (on
         battery and Accounts.OnBattery "pause"), "power-saver" (on battery in
         the power-saver profile and Accounts.OnBattery "power-saver"), or
         empty. It stops what Pause
         stops, but is not the user's pause: Paused stays false, and it is
         worked out again from the machine's state after a restart. -->
    <property name="HeldBack" type="s" access="read"/>
    <!-- Whether the folder takes changes now, and what is added, changed,
         moved or deleted in it is uploaded: its mount is up and switched to
         read-write, which follows its account's Mode. False for a folder
         that is not up, and for one whose account is read-only: the mount
         then refuses every change. -->
    <property name="Writable" type="b" access="read"/>
    <!-- How changes made in OneDrive reach this computer: "connected" (at
         once, through Graph's notification socket; the poll runs every 5
         minutes as a safety net), "connecting" (trying, or waiting before the
         next try; the poll runs every minute), or "off" (paused, held back,
         or not a OneDrive folder: nothing is asked of OneDrive). -->
    <property name="LiveChanges" type="s" access="read"/>
    <!-- See SetThumbnails; true until it is called. -->
    <property name="Thumbnails" type="b" access="read"/>
    <!-- See SetFreeSpaceReserve; 10 until it is called. -->
    <property name="FreeSpaceReserve" type="t" access="read"/>
  </interface>
</node>
