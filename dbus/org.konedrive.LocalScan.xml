<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/konedrive/Accounts/<id>: the check of this account's folder on
       disk at the start of its sync: before the mount goes over the folder,
       what the directory under it holds is compared with the daemon's
       store, once, for what changed while no daemon ran. Nothing scans the
       folder while its sync runs: the mount records each change as it is
       made. Published when a check begins and when it ends. -->
  <interface name="org.konedrive.LocalScan">
    <!-- running, idle, or none (no check since the daemon started). -->
    <property name="State" type="s" access="read"/>
    <!-- Why the running, or the last, check runs: start. -->
    <property name="Reason" type="s" access="read"/>
    <!-- Unix seconds. -->
    <property name="Started" type="x" access="read"/>
    <!-- Unix seconds when the last check finished, 0 for none since the
         daemon started; Took: how long it took, in seconds. -->
    <property name="Finished" type="x" access="read"/>
    <property name="Took" type="u" access="read"/>
  </interface>
</node>
