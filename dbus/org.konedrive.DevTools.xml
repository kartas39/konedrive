<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/konedrive/Accounts. Development only: a release build's daemon
       does not serve it. -->
  <interface name="org.konedrive.DevTools">
    <!-- Adds a signed-out, read-only account with no folder, which never has
         to sign in, and returns its object path: for a folder that shows a
         local directory. InvalidArgs for a label that is empty, longer than
         40 characters, contains "/" or a control character, is 12 hexadecimal
         digits (the shape of an account's id), or is already used (regardless
         of case); the message says which. The label is trimmed first. Failed
         while config.toml cannot be read. -->
    <method name="AddAccount">
      <arg name="label" type="s" direction="in"/>
      <arg name="account" type="o" direction="out"/>
    </method>
  </interface>
</node>
