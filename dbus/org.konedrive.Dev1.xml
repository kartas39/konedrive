<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/konedrive/Accounts/<id>. Development only. -->
  <interface name="org.konedrive.Dev1">
    <!-- An access token of this account that can change nothing: about an
         hour of Files.Read on its drive, whatever the account's mode — for a
         read-write account, one obtained by a refresh that asks for
         Files.Read only. Never the refresh token, which stays in the wallet.
         Refused NotSignedIn when there is none. -->
    <method name="AccessToken">
      <arg name="token" type="s" direction="out"/>
    </method>
    <!-- For the test-account harness only: this account's current access
         token, which can change its files (Files.ReadWrite). Refused
         WritesNotAllowed unless the account's drive is in
         write_test_drive_ids in config.toml, ModeNotGranted unless the
         account is read-write, and NotSignedIn when there is no token. -->
    <method name="ReadWriteAccessToken">
      <arg name="token" type="s" direction="out"/>
    </method>
  </interface>
</node>
