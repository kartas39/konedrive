<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/konedrive/Accounts. Per-file calls, each routed by path to the
       account whose folder holds the path: the directory part is resolved
       first (`..` and links to directories), and the account is the one
       whose folder is a component prefix of it. Routing never opens the
       file. A path in no account's folder is
       refused OutsideRoot (ItemState answers "not-managed"). Once routed,
       each call acts in that account's folder. -->
  <interface name="org.konedrive.Files">
    <!-- Downloads one file now. A file already downloaded is left as it is. -->
    <method name="Hydrate">
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- Frees up one downloaded file's space: its copy on disk goes, and
         the folder goes on showing the file, which is downloaded again when
         it is opened. A file with a change waiting to be uploaded is
         refused NotUploaded: freeing it up would lose the change. A file a
         pin holds for is refused NotAllowed: FreeUp is what lets it go. -->
    <method name="Dehydrate">
      <arg name="path" type="s" direction="in"/>
    </method>
    <method name="ItemState">
      <arg name="path" type="s" direction="in"/>
      <arg name="state" type="s" direction="out"/>
    </method>
    <!-- "Always keep on this device": a pin holds for each path from now on
         (a file or a folder; a folder pins everything under it, now and
         later), and the download of every file under it that is online-only
         is queued. A folder is pinned whole: a pin or an exception below it
         comes off. A path already pinned by a folder above it gets no pin of
         its own, and loses the exception it had. Every path is routed before
         anything is pinned: one path in no folder refuses the whole call and
         changes nothing. Returns how many paths a mark changed for, summed
         over the accounts. -->
    <method name="Pin">
      <arg name="paths" type="as" direction="in"/>
      <arg name="queued" type="u" direction="out"/>
    </method>
    <!-- Unchecking "Always keep on this device": no pin holds for each path
         from now on, and nothing else changes — files stay downloaded, as on
         Windows. A path pinned by a folder above it gets an exception: the
         folder stays pinned, and the path and everything under it are not
         kept, until Pin of the path takes the exception off. A folder is let
         go whole: a pin or an exception below it comes off. Routed as Pin.
         Returns how many paths a mark changed for, summed over the
         accounts. -->
    <method name="Unpin">
      <arg name="paths" type="as" direction="in"/>
      <arg name="unpinned" type="u" direction="out"/>
    </method>
    <!-- "Free up space" for chosen paths: no pin holds for each path from
         now on, as after Unpin (a path pinned by a folder above it gets an
         exception, and the folder stays pinned), and then everything under it
         is freed. skipped_pinned counts the downloaded files left because a
         download is filling them, a program holds them open for writing or
         they hold a change not uploaded yet. A file named
         itself that has a change waiting to be uploaded refuses the call
         NotUploaded, before anything changes; one inside a folder is left.
         Routed as Pin. Counts are summed over the accounts. -->
    <method name="FreeUp">
      <arg name="paths" type="as" direction="in"/>
      <arg name="files" type="u" direction="out"/>
      <arg name="bytes" type="t" direction="out"/>
      <arg name="skipped_pinned" type="u" direction="out"/>
    </method>
    <!-- "Open in OneDrive": the address of the page OneDrive's web interface
         has for the file or folder at the path. The path is opened as Pin
         opens it (nothing is downloaded) for its item id, and OneDrive is
         asked for that item: one GET, with the client's usual retries, so
         the answer can take as long as they do. Nothing is changed, on disk
         or in OneDrive, and no browser is started: the caller opens the
         address. The path of an account's folder itself is answered too,
         with the address of the drive's root.
         Refused NotManaged for a file of the user's own or a reserved name,
         NotUploaded for an item with no id (OneDrive does not have it yet),
         NotSignedIn for an account that is signed out, Unreachable when
         OneDrive does not answer (the message is the cause), and Failed otherwise (the item is gone
         from OneDrive, or the answer carries no address). -->
    <method name="WebUrl">
      <arg name="path" type="s" direction="in"/>
      <arg name="url" type="s" direction="out"/>
    </method>
    <!-- What a file manager's context menu may offer for a selection: one
         call per menu, so that the rules of Pin, Unpin, FreeUp and WebUrl are
         decided here and nowhere else. Nothing is changed and no file is
         opened (nothing is downloaded): the answer comes from what the
         daemon's store says of the paths, and does not wait for a
         sync that is writing to the account's store. The keys:
           paths (as): the selected paths Pin takes, in the order given;
             what Pin, Unpin or FreeUp is then called with. A path in no
             account's folder, a link, a file of the user's own, a reserved
             name and an account's folder itself are left out.
           always-keep (s): "hidden" (paths is empty); "off"; "on" (a pin
             holds for every path, its own or that of a folder above).
           free-up (s): "hidden" (no path is a folder, a downloaded file or
             a file a pin holds for); "enabled"; "disabled" (FreeUp of
             paths would be refused: free-up-why says for what).
           free-up-why (s): why free-up is "disabled"; empty otherwise.
             "not-uploaded": a downloaded file among the paths has a change
             waiting to be uploaded. Over several accounts' folders the
             answer is that of the first account that refuses, in the order
             the accounts' paths first come in the selection.
           open-online (s): "hidden" (not exactly one path selected, or one
             that is neither in paths nor an account's folder itself);
             "enabled"; "disabled" (the item is not in OneDrive yet).
           open-online-path (s): the path WebUrl is then called with; empty
             when open-online is "hidden".
         Never refused for a path it does not take. The answer is about the
         moment it was asked: a call made after it can still be refused. -->
    <method name="Menu">
      <arg name="paths" type="as" direction="in"/>
      <arg name="menu" type="a{sv}" direction="out"/>
    </method>
  </interface>
</node>
