<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/konedrive/Accounts: the accounts of this user. The same object
       implements org.konedrive.Files1 and org.freedesktop.DBus.ObjectManager,
       which announces each account object below it (InterfacesAdded once it
       is exported, InterfacesRemoved when it goes). Each account is the
       object /org/konedrive/Accounts/<id>, with org.konedrive.Account1,
       org.konedrive.Sync1 and org.konedrive.Dev1. Personal Microsoft
       accounts only in this version. Nothing is served at
       /org/konedrive/Daemon any more. -->
  <interface name="org.konedrive.Accounts1">
    <!-- Adds a signed-out, read-only account with no folder, and returns its
         object path. InvalidArgs for a label that is empty, longer than 40
         characters, contains "/", "@" or a control character, or is already
         used (regardless of case); the label is trimmed first. Failed while
         config.toml cannot be read. -->
    <method name="Add">
      <arg name="label" type="s" direction="in"/>
      <arg name="account" type="o" direction="out"/>
    </method>
    <!-- Removes an account: forgets its folder exactly as Sync1.UnregisterRoot
         does (so refused NoHelper under the same rule, before anything
         changes), cancels a sign-in under way, deletes its refresh token, its
         cached name and quota and its tree store, then removes the object.
         The folder's files and the rescued files are kept. NoAccount for a
         path that names no account. -->
    <method name="Remove">
      <arg name="account" type="o" direction="in"/>
    </method>
    <!-- The Entra application every account signs in with. InvalidArgs for a
         malformed id; refused Failed while any account is signing in or
         signed in. -->
    <method name="SetClientId">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- Every account, in the order it was added: the order of the window's
         switcher, the tray's tooltip and `konedrivectl account list`. -->
    <property name="Accounts" type="ao" access="read"/>
    <property name="ClientId" type="s" access="read"/>
    <!-- The privileged helper, as the daemon sees it: "connected" (files
         download when opened), "not-installed" (no konedrive-helper service
         on this system), "stopped" (installed, not running: systemctl start
         konedrive-helper), "failed" (the service failed: systemctl status
         konedrive-helper), "unknown" (systemd cannot be asked, or the helper
         has started but the daemon has no link to it yet). A OneDrive
         folder is kept in step only while this is "connected". Moved here
         from Sync1: one helper serves every account. -->
    <property name="HelperState" type="s" access="read"/>
    <!-- Trouble that belongs to no account: config.toml cannot be read, or
         was written by a newer version, or a migration step failed. Empty
         when there is none. -->
    <property name="LastError" type="s" access="read"/>
  </interface>
</node>
