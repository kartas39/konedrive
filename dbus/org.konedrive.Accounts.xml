<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <!-- /org/konedrive/Accounts: the accounts of this user. The same object
       implements org.konedrive.Files and org.freedesktop.DBus.ObjectManager,
       which announces each account object below it (InterfacesAdded once it
       is exported, InterfacesRemoved when it goes). Each account is the
       object /org/konedrive/Accounts/<id>, with org.konedrive.Account,
       org.konedrive.Folder, org.konedrive.Transfers,
       org.konedrive.UploadQueue, org.konedrive.Conflicts,
       org.konedrive.LocalScan, org.konedrive.ActivityLog and
       org.konedrive.TokenExport. Personal Microsoft accounts only in this
       version. Nothing is served at /org/konedrive/Daemon any more. -->
  <interface name="org.konedrive.Accounts">
    <!-- Adds a signed-out, read-only account with no folder, and returns its
         object path. InvalidArgs for a label that is empty, longer than 40
         characters, contains "/" or a control character, is 12 hexadecimal
         digits (the shape of an account's id), or is already used (regardless
         of case); the message says which. "@" is allowed: a label may be an
         email. The label is trimmed first. Failed while config.toml cannot be
         read. -->
    <method name="Add">
      <arg name="label" type="s" direction="in"/>
      <arg name="account" type="o" direction="out"/>
    </method>
    <!-- Adds a new account by signing in. Adds a draft, starts its sign-in
         and returns the draft's object path and the URL to open in a browser.
         A draft is an account that is on the bus at its path and is not in
         List. Refused as Account.BeginSignIn is, under the same error name,
         and then nothing is left. One draft at a time: a SignIn while a draft
         exists ends that draft as "cancelled" first. Account.CancelSignIn on
         the draft cancels it. How a draft ends is said by SignInFinished. -->
    <method name="SignIn">
      <arg name="account" type="o" direction="out"/>
      <arg name="url" type="s" direction="out"/>
    </method>
    <!-- Sent exactly once for every draft SignIn answered, except one a
         restart of the daemon removed. outcome:
         "signed-in": the account is in List under its final label, which is
           message: its email; "<email> 2", "<email> 3", ... when another
           account has that label; "Personal", "Personal 2", ... when there
           is no email or it cannot be a label. List changes before this is
           sent;
         "cancelled": Account.CancelSignIn on the draft, or a newer SignIn;
           message is empty;
         "already-added": the drive is another account's; message is that
           account's label;
         "failed": anything else, the timeout included; message says why, as
           Account.LastError would.
         After every outcome but "signed-in" nothing is left of the draft: no
         entry in config.toml, no directory, no stored token, no object. -->
    <signal name="SignInFinished">
      <arg name="account" type="o"/>
      <arg name="outcome" type="s"/>
      <arg name="message" type="s"/>
    </signal>
    <!-- Removes an account: forgets its folder exactly as Folder.Unregister
         does (so refused NoHelper under the same rule, before anything
         changes), cancels a sign-in under way, deletes its refresh token, its
         cached name and quota and its tree store, then removes the object.
         The folder's files and the rescued files are kept. NoAccount for a
         path that names no account. Refused PendingUploads, as
         Folder.Unregister is, while changes made here wait to be
         uploaded. Failed when the token cannot be deleted or config.toml
         cannot be written after the folder was forgotten: the account stays,
         and the message says what was done to its folder and its sign-in. -->
    <method name="Remove">
      <arg name="account" type="o" direction="in"/>
    </method>
    <!-- The Entra application every account signs in with. InvalidArgs for a
         malformed id; refused Failed while any account is signing in or
         signed in. -->
    <method name="SetClientId">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- The hold's settings (issues #57, #95), one pair for every account:
         each is written to config.toml and taken by every account at once,
         and a change ends every account's Folder.SyncAnyway.
         SetPauseOnMetered: whether every account holds back on a metered
         connection. -->
    <method name="SetPauseOnMetered">
      <arg name="on" type="b" direction="in"/>
    </method>
    <!-- What every account does on battery: "sync" (nothing), "power-saver"
         (holds back while on battery in the power-saver profile) or "pause"
         (holds back whenever on battery). Refused
         org.freedesktop.DBus.Error.InvalidArgs for anything else. -->
    <method name="SetOnBattery">
      <arg name="choice" type="s" direction="in"/>
    </method>
    <!-- Every account, in the order it was added: the order of the window's
         switcher, the tray's tooltip and `konedrivectl account list`. -->
    <property name="List" type="ao" access="read"/>
    <property name="ClientId" type="s" access="read"/>
    <!-- See SetPauseOnMetered and SetOnBattery; true and "power-saver" until
         they are called. -->
    <property name="PauseOnMetered" type="b" access="read"/>
    <property name="OnBattery" type="s" access="read"/>
    <!-- The privileged helper, as the daemon sees it: "connected" (files
         download when opened), "not-installed" (no konedrive-helper service
         on this system), "stopped" (installed, not running: systemctl start
         konedrive-helper), "failed" (the service failed: systemctl status
         konedrive-helper), "unknown" (systemd cannot be asked, or the helper
         has started but the daemon has no link to it yet). A OneDrive
         folder is kept in step only while this is "connected". Here rather
         than on each account: one helper serves every account. -->
    <property name="HelperState" type="s" access="read"/>
    <!-- Trouble that belongs to no account: config.toml cannot be read, or
         was written by a newer version, or a migration step failed. Empty
         when there is none. -->
    <property name="LastError" type="s" access="read"/>
    <!-- The running daemon's build: its version (X.Y.Z for a release,
         X.Y.Z-dev.N for a package built from any other commit, X.Y.Z-dev for
         a plain cargo build) and the full hash of its commit, or "unknown"
         (docs/releasing.md). A client built from another commit shows that
         the daemon should be restarted. Never change while the daemon runs. -->
    <property name="Version" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
    <property name="Commit" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="const"/>
    </property>
  </interface>
</node>
