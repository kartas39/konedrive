[Global]
IconName=folder-cloud
Name=KOneDrive
Comment=OneDrive for KDE
DesktopEntry=org.konedrive.KOneDrive

[Event/signedOut]
Name=Signed out of OneDrive
Comment=The account was signed out or needs signing in again
Action=Popup

[Event/diskFull]
Name=Not enough disk space
Comment=A file could not be downloaded because the disk is full
Action=Popup

[Event/downloadFailed]
Name=Download failed
Comment=A file could not be downloaded
Action=Popup

[Event/updateFailed]
Name=File not updated
Comment=A file changed in OneDrive could not be updated on this computer
Action=Popup

[Event/conflict]
Name=Changed on both sides
Comment=A file changed here and in OneDrive: both versions are kept
Action=Popup

[Event/uploadFailed]
Name=Upload failed
Comment=A change made on this computer cannot be uploaded: a name OneDrive refuses, a full OneDrive, a sign-in without the permission
Action=Popup

[Event/notRemovedHere]
Name=Folder not removed
Comment=A folder could not be removed on this computer because it holds items that cannot be shown here
Action=Popup

[Event/nameTaken]
Name=Name taken in OneDrive
Comment=A name could not be used on this computer because OneDrive has an item of that name that cannot be shown here
Action=Popup

[Event/throttled]
Name=OneDrive asked to wait
Comment=A file that is not on this computer could not be opened because OneDrive asked to wait
Action=Popup

[Event/newerRelease]
Name=New release
Comment=A newer release of KOneDrive is out on GitHub
Action=Popup
